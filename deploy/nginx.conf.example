# Example reverse proxy. Copy to /etc/nginx/sites-available/txtgrep,
# edit server_name / proxy_pass, then enable and reload nginx.
server {
    listen 80;
    listen [::]:80;
    server_name txtgrep.example.com;

    client_max_body_size 16k;

    location / {
        proxy_pass http://127.0.0.1:8083;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

# For HTTPS, add a TLS listener with your own certificate (e.g. certbot):
