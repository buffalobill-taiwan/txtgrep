# Copy to .env and edit as needed. Real environment variables override these values.

# Local PostgreSQL socket by default. Use a full DSN for TCP or Docker:
# pgsql:host=127.0.0.1;port=5432;dbname=txtgrep
TXTGREP_DSN=pgsql:dbname=txtgrep
TXTGREP_DB_USER=
TXTGREP_DB_PASSWORD=

# Corpus root. Relative paths are resolved against the project root.
TXTGREP_CORPUS=txt
# Prefix stored in the DB and used in URLs.
TXTGREP_PATH_PREFIX=txt

TXTGREP_PORT=8083
TXTGREP_LIMIT=500
TXTGREP_TIMEOUT_MS=40000

# Used only by docker-compose.yml
TXTGREP_DB_NAME=txtgrep
